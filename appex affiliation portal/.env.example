# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/appex_affiliation"
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_ACCESS_SECRET="your-super-secure-access-secret-key-256-bits"
JWT_REFRESH_SECRET="your-super-secure-refresh-secret-key-256-bits"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@domain.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@appex.co.zw"
EMAIL_FROM_NAME="AppEx Affiliation Portal"

# SMS Configuration (Africa's Talking)
AFRICASTALKING_USERNAME="your-africastalking-username"
AFRICASTALKING_API_KEY="your-africastalking-api-key"
AFRICASTALKING_SENDER_ID="AppEx"

# Application Configuration
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"
API_BASE_URL="http://localhost:3001"

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760" # 10MB
ALLOWED_FILE_TYPES="jpg,jpeg,png,pdf,doc,docx"

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
DEVICE_FINGERPRINT_SALT="your-device-fingerprint-salt"

# OAuth Configuration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/google/callback"

FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
FACEBOOK_REDIRECT_URI="http://localhost:3001/auth/facebook/callback"

# Payment Configuration (EcoCash, PayNow, etc.)
ECOCASH_API_URL="https://api.ecocash.co.zw"
ECOCASH_API_KEY="your-ecocash-api-key"
ECOCASH_MERCHANT_CODE="your-merchant-code"

PAYNOW_API_URL="https://www.paynow.co.zw"
PAYNOW_INTEGRATION_ID="your-integration-id"
PAYNOW_INTEGRATION_KEY="your-integration-key"

# Monitoring and Logging
LOG_LEVEL="info"
LOG_FILE="./logs/app.log"
SENTRY_DSN="your-sentry-dsn-for-error-tracking"

# Redis Configuration for Sessions
SESSION_REDIS_URL="redis://localhost:6379/1"
CACHE_REDIS_URL="redis://localhost:6379/2"

# Background Jobs
JOB_REDIS_URL="redis://localhost:6379/3"
JOB_CONCURRENCY=5

# Zimbabwe-specific Configuration
DEFAULT_CURRENCY="USD"
DEFAULT_TIMEZONE="Africa/Harare"
SUPPORT_EMAIL="support@appex.co.zw"
SUPPORT_PHONE="+263242123456"
BUSINESS_ADDRESS="123 Samora Machel Ave, Harare, Zimbabwe"

# Data Center Configuration
DATA_CENTER_LOCATION="Zimbabwe"
DATA_RETENTION_YEARS="7"

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_AUTH=true
ENABLE_KYC_UPLOAD=true
ENABLE_PAYOUTS=true
ENABLE_REFERRALS=true

# Development Configuration
CORS_ORIGIN="http://localhost:3000"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false

# Production Configuration (uncomment for production)
# NODE_ENV="production"
# CORS_ORIGIN="https://appex.co.zw"
# COOKIE_DOMAIN=".appex.co.zw"
# COOKIE_SECURE=true
# LOG_LEVEL="warn"
